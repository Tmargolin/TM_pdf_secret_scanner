{
  "name": "tm-pdf-secret-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that scans PDFs handed to allow-listed sites for secrets using the Prompt Security API.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.ts",
    "build:dev": "node build.ts --dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
