{
  "name": "tm-pdf-secret-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that scans PDFs handed to allow-listed sites for secrets using the Prompt Security API.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.ts",
    "build:dev": "node build.ts --dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "mock-api": "node scripts/mock-api.mjs",
    "serve:test-pages": "node scripts/serve-test-pages.mjs",
    "fixtures": "node scripts/make-fixtures.ts",
    "package": "node scripts/package.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
